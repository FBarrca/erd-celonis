# Celonis tenant URL, without a trailing slash
CELONIS_URL=https://tenant.celonis.cloud

# OAuth 2.0 client-credentials configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=

# Token authorization type. USER_KEY uses the Bearer scheme and is suitable
# for OAuth access tokens and user API tokens. Use APP_KEY for application keys.
CELONIS_KEY_TYPE=USER_KEY
